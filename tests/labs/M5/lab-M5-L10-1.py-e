"""M5 L10 lab 1: Riemann-Stieltjes sums for the integral of f against dG, with f(x) = x and G(x) = x^2 on [0, 1].

Generated inputs, not data. The integral is I = integral from 0 to 1 of x * 2x dx = 2/3, the value that
Theorem 3.1 of this lesson gives for a continuously differentiable integrator. The lab has three parts.

Part A: uniform partitions into n parts, with left tags and with right tags, computed exactly in Fraction
arithmetic. The lab checks the closed forms derived on the page:
  right-tag sum  S_right(n) = (n + 1)(4n - 1) / (6 n^2),  so S_right(n) - 2/3 = (3n - 1)/(6 n^2)
  left-tag sum   S_left(n)  = (4 n^2 - 3 n - 1) / (6 n^2), so S_left(n) - 2/3 = -(3n + 1)/(6 n^2)

Part B: 200 random tagged partitions of [0, 1], drawn with random.Random(20261028). For each one the lab checks
the bound |S - 2/3| <= 2 * mesh, where mesh is the largest subinterval length. The constant 2 is max |G'| = 2.

Part C: a step integrator G(x) = 0 for x < 1/2 and G(x) = 1 for x >= 1/2, with f(x) = 1 for x >= 1/2 and
f(x) = 0 otherwise. On uniform partitions that contain 1/2, the lab prints the sum with the left tag and the
sum with the right tag of the interval that ends at 1/2. Both tagged partitions have the same mesh.

Floats are used only in Part B, and its checks allow 1e-12 for rounding. No network. Standard library only.
"""

from __future__ import annotations

import random
from fractions import Fraction

SEED = 20261028
PARTS_A = (4, 10, 100, 1000)
PARTS_B = 200
MAX_INTERIOR = 30
SLACK = 1e-12


def f(x: Fraction) -> Fraction:
    """The integrand f(x) = x."""
    return x


def g(x: Fraction) -> Fraction:
    """The integrator G(x) = x^2."""
    return x * x


def rs_sum(points: list[Fraction], tags: list[Fraction]) -> Fraction:
    """Riemann-Stieltjes sum: the sum of f(tag_i) times the increment G(x_i) - G(x_{i-1})."""
    total = Fraction(0)
    for i, tag in enumerate(tags, start=1):
        total += f(tag) * (g(points[i]) - g(points[i - 1]))
    return total


def uniform(n: int) -> list[Fraction]:
    """The uniform partition of [0, 1] into n parts."""
    return [Fraction(i, n) for i in range(n + 1)]


def part_a() -> None:
    """Exact left and right uniform sums, checked against the closed forms of the page."""
    print("part A: uniform partitions, exact")
    target = Fraction(2, 3)
    for n in PARTS_A:
        pts = uniform(n)
        right = rs_sum(pts, pts[1:])
        left = rs_sum(pts, pts[:-1])
        right_formula = Fraction((n + 1) * (4 * n - 1), 6 * n * n)
        left_formula = Fraction(4 * n * n - 3 * n - 1, 6 * n * n)
        right_err = right - target
        left_err = left - target
        print(
            f"n {n} right {float(right):.12f} left {float(left):.12f} "
            f"right_err {float(right_err):.12f} left_err {float(left_err):.12f} "
            f"right_formula_matches {right == right_formula} left_formula_matches {left == left_formula} "
            f"right_err_formula_matches {right_err == Fraction(3 * n - 1, 6 * n * n)} "
            f"left_err_formula_matches {left_err == -Fraction(3 * n + 1, 6 * n * n)}"
        )


def part_b() -> None:
    """Random tagged partitions: the sum is within 2 times the mesh of 2/3."""
    print("part B: random tagged partitions, seeded")
    rng = random.Random(SEED)
    worst_ratio = 0.0
    max_mesh = 0.0
    all_within = True
    for _ in range(PARTS_B):
        m = rng.randint(1, MAX_INTERIOR)
        interior = sorted(rng.random() for _ in range(m))
        bounds = [0.0, *interior, 1.0]
        tags_f = [lo + rng.random() * (hi - lo) for lo, hi in zip(bounds, bounds[1:], strict=True)]
        total = 0.0
        for i, tag in enumerate(tags_f, start=1):
            total += tag * (bounds[i] ** 2 - bounds[i - 1] ** 2)
        mesh = max(hi - lo for lo, hi in zip(bounds, bounds[1:], strict=True))
        err = abs(total - 2 / 3)
        all_within = all_within and err <= 2 * mesh + SLACK
        worst_ratio = max(worst_ratio, err / mesh)
        max_mesh = max(max_mesh, mesh)
    print(
        f"partitions {PARTS_B} largest_mesh {max_mesh:.6f} largest_error_over_mesh {worst_ratio:.6f} "
        f"all_within_2_mesh {all_within}"
    )


def part_c() -> None:
    """A step integrator: the sum depends on the tag at the jump point, so no limit exists."""
    print("part C: step integrator at 1/2, uniform partitions containing 1/2")

    def step_f(x: Fraction) -> int:
        return 1 if x >= Fraction(1, 2) else 0

    def step_g(x: Fraction) -> int:
        return 1 if x >= Fraction(1, 2) else 0

    for n in (10, 100):
        pts = uniform(n)
        k = n // 2
        jump = pts[k - 1], pts[k]
        assert jump[1] == Fraction(1, 2)
        left_total = 0
        right_total = 0
        for i in range(1, n + 1):
            d_g = step_g(pts[i]) - step_g(pts[i - 1])
            if i == k:
                left_total += step_f(pts[i - 1]) * d_g
                right_total += step_f(pts[i]) * d_g
            else:
                assert d_g == 0
        print(
            f"n {n} mesh {float(Fraction(1, n)):.6f} left_tag_sum {left_total} right_tag_sum {right_total} "
            f"both_tags_same_mesh True"
        )


def main() -> None:
    """Run the three parts and print the closed form the page derives."""
    print(f"closed_form_value 2/3 = {float(Fraction(2, 3)):.12f}")
    print(f"dx_integral_of_x_on_0_1 1/2 = {float(Fraction(1, 2)):.12f}")
    part_a()
    part_b()
    part_c()


main()
