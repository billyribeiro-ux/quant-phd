responses = [{'choice': 'A', 'pair_id': 0, 'prizes_a': [23965, 38732, 14815], 'prizes_b': [42896, 20230], ...}, {'choice': 'A', 'p... ...}, {'choice': 'A', 'pair_id': 5, 'prizes_a': [-2474, -32777, 1218], 'prizes_b': [46401, -46943, -17138], ...}, ...]

