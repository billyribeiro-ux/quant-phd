control: exit=0 stdout_lines=17 last_stderr=
blank_cell: exit=1 stdout_lines=3 last_stderr=ValueError: 1996-01: GBP cell is '', not a decimal rate
non_decimal: exit=1 stdout_lines=3 last_stderr=ValueError: 1996-01: GBP cell is '1.2.3', not a decimal rate
month_gap: exit=1 stdout_lines=3 last_stderr=ValueError: 1996-02 does not follow the previous month in fx_monthly.csv
zero_rate: exit=1 stdout_lines=3 last_stderr=ValueError: 1996-01: GBP rate must be positive
negative_rate: exit=1 stdout_lines=3 last_stderr=ValueError: 1996-01: GBP cell is '-1.5', not a decimal rate
missing_column: exit=1 stdout_lines=3 last_stderr=ValueError: fx_monthly.csv has no column 'GBP'
exponent_cell: exit=1 stdout_lines=3 last_stderr=ValueError: 1996-01: GBP cell is '1.5e2', not a decimal rate
